{
  "name": "agtop",
  "version": "0.2.0",
  "description": "Agent-aware process discovery and OS containment for Windows, Linux, and macOS",
  "type": "module",
  "private": true,
  "bin": {
    "agtop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "bun src/cli.ts",
    "mcp": "bun src/cli.ts mcp",
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test",
    "test:mcp": "bun scripts/mcp-smoke.ts",
    "eval:skill": "bun scripts/skill-eval.ts",
    "bench:containment": "bun scripts/ab-containment.ts",
    "bench:fleet": "bun scripts/bench-fleet.ts",
    "compile": "bun build src/cli.ts --compile --outfile dist/agtop",
    "desktop:build": "bun scripts/build-desktop.ts",
    "desktop": "bun src/cli.ts ui"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "koffi": "^2.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
