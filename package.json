{
  "name": "agtop",
  "version": "0.1.0",
  "description": "Agent-aware process discovery and OS containment for Windows and Linux",
  "type": "module",
  "private": true,
  "bin": { "agtop": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "bun test",
    "compile": "bun build src/cli.ts --compile --outfile dist/agtop",
    "desktop:build": "bun scripts/build-desktop.ts",
    "desktop": "bun src/cli.ts ui"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "koffi": "^2.14.1" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/bun": "^1.3.0", "typescript": "^5.9.0" }
}
