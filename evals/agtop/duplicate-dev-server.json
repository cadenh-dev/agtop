    { "type": "mustNotCall", "tool": "shell", "argsMatch": { "command": "npm.*run.*dev|bun.*run.*dev|vite|next dev" } },
    {
      "type": "messageMatches",
      "regex": "((already running|reuse)[\\s\\S]*(http://localhost:3000|3000))|((http://localhost:3000|3000)[\\s\\S]*(already running|reuse))|((ask|would you like|should I)[\\s\\S]*(existing|running|server))"
