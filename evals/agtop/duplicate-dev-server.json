      "tool": "agtop_list",
      "args": {},
      "result": {
        "jobs": [
          {
            "jobId": "agent-dev-22",
            "harness": "custom",
            "peer": "agent-22",
            "owned": false,
            "command": "npm run dev",
            "cwd": "C:/work/agent-aware-process-manager",
            "git": { "repoRoot": "C:/work/agent-aware-process-manager", "isWorktree": false },
            "roleCounts": { "server": 1 },
            "cpuPercent": 4.1,
            "memoryMb": 384,
            "gpuPercent": 0,
            "npuPercent": 0,
            "processCount": 1,
            "listening": ["127.0.0.1:3000"]
          }
